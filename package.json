{
  "name": "mars-rob",
  "version": "1.0.0",
  "description": "Robôs programáveis numa malha com obstáculos: CLI e interface web",
  "scripts": {
    "dev": "tsx src/main.ts",
    "serve": "tsx src/main.ts --servidor",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "web:install": "npm ci --prefix web",
    "web:dev": "npm run dev --prefix web",
    "web:build": "npm run build --prefix web",
    "web:test": "npm test --prefix web",
    "web:check": "npm run web:test && npm run web:build",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run test:coverage && npm run build && npm run web:check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "ws": "^8.23.0"
  }
}
